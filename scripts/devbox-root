#!/bin/sh
# Open a PTY-backed root shell through the root-owned local broker. Unlike
# setuid sudo this does not attempt to gain privileges in the caller process,
# so it works when Cloud Run enforces no_new_privs.
set -eu

SOCKET=/run/devbox/root-shell.sock
if [ ! -S "$SOCKET" ]; then
  printf '%s\n' 'devbox-root: root shell service is not ready' >&2
  exit 1
fi

exec /usr/bin/socat STDIO,raw,echo=0 UNIX-CONNECT:"$SOCKET"
