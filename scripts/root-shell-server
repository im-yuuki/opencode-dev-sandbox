#!/bin/sh
# Cloud Run sets no_new_privs, so a user process cannot become root through a
# setuid binary such as sudo. This broker starts as root under supervisord and
# creates a root shell on demand over a local Unix socket instead.
set -eu

SOCKET=/run/devbox/root-shell.sock
rm -f "$SOCKET"

# Only root and members of the existing sudo group may connect. Each client
# gets an isolated PTY-backed login shell; fork keeps the listener available
# for later terminals.
exec /usr/bin/socat \
  UNIX-LISTEN:"$SOCKET",fork,mode=0660,user=root,group=sudo \
  "EXEC:/bin/bash -l,pty,stderr,setsid,sigint,sane"
