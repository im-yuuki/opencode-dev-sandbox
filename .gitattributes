# Normalize line endings
* text=auto

# Shell scripts: LF only, no CRLF mangling
*.sh text eol=lf
*.bash text eol=lf

# Configs consumed inside Linux containers must stay LF
Dockerfile text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# HTML/JS web assets
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf

# Images are binary
*.png binary
*.jpg binary
*.svg text

# Diff helpers
*.py diff=python
*.md diff=markdown