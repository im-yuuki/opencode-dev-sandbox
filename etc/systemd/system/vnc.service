[Unit]
Description=TigerVNC server (KDE Plasma X11) on :1
After=systemd-user-sessions.service
Wants=dbus.service

[Service]
Type=forking
User=user
Group=user
Environment=HOME=/workspace
Environment=USER=user
Environment=SHELL=/bin/bash
Environment=XDG_RUNTIME_DIR=/run/user/1000
PIDFile=/workspace/.config/tigervnc/%H:1.pid
ExecStartPre=-/usr/bin/vncserver -kill :1
ExecStart=/usr/bin/vncserver :1 -geometry 1600x1000 -depth 24 -SecurityTypes None -localhost yes -xstartup /workspace/.config/tigervnc/xstartup
ExecStop=/usr/bin/vncserver -kill :1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target