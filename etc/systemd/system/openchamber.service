[Unit]
Description=OpenChamber (OpenCode web UI)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/workspace
Environment=HOME=/workspace
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Loopback only: nginx (port 8080) is the single external boundary and does
# PAM auth. --lan would force UI authentication, which we deliberately skip.
ExecStart=/usr/bin/openchamber serve --foreground --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target