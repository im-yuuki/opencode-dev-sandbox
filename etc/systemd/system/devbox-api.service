[Unit]
Description=DevBox control API (PAM auth + systemd control)
After=network.target dbus.service
Wants=dbus.service

[Service]
Type=simple
ExecStart=/usr/bin/env python3 /opt/devbox/backend/server.py
Environment=DEVBOX_USER=user
Environment=DEVBOX_BIND=127.0.0.1
Environment=DEVBOX_PORT=3100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target