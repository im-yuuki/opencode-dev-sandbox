[Unit]
Description=ttyd (web terminal for user)
After=network.target
Wants=network.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/workspace
Environment=HOME=/workspace
Environment=TERM=xterm-256color
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Bound to loopback: nginx terminates auth and proxies /terminal/.
# -W enables write access (interactive shell rather than read-only view).
ExecStart=/usr/local/bin/ttyd --port 7681 --interface 127.0.0.1 --writable --base-path /terminal /bin/bash -l
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target